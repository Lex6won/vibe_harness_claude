{
  "mcpServers": {
    "vibecode-checker": {
      "command": "python",
      "args": ["-m", "gvskb.server"],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "GVSKB_MODE": "offline",
        "GVSKB_POLICIES_DIR": "${CLAUDE_PROJECT_DIR:-.}/.claude/references/policies"
      }
    }
  }
}
